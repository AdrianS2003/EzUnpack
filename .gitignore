# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Native build output inside local Expo modules. `.cxx` also holds the
# libarchive source that CMake downloads at build time — thousands of files
# that are fetched again on demand and must never be committed.
modules/*/android/build/
modules/*/android/.cxx/
.gradle/
