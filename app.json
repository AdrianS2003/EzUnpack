{
  "expo": {
    "name": "EzUnpack",
    "slug": "ez-unpack",
    "version": "1.0.0",
    "scheme": "ezunpack",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F4F8"
        }
      ],
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "EzUnpack shows you the photos it has saved for you.",
          "savePhotosPermission": "EzUnpack puts the photos from your archives into Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "disableIOS": true
        }
      ],
      "./plugins/with-archive-open-with",
      "expo-sharing"
    ],
    "android": {
      "package": "com.ezunpack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#F0F4F8"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a077311-eede-437c-9d3c-0116949914f2"
      }
    }
  }
}
